# LLM provider: "ollama" (local), "nvidia" (NIM) ou "gemini" (Google Gemini)
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:1.7b = léger (fonctionne sur la plupart des GPU/CPU)
# Ornith-1.0-9B = plus précis mais exige ~8 Go de VRAM
OLLAMA_MODEL=qwen3:1.7b
# 0 = CPU uniquement (fiable), 1+ = couches sur GPU, -1 = comportement par défaut
OLLAMA_NUM_GPU=0

# --- NVIDIA NIM (build.nvidia.com) ---
# Clé API gratuite : https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Google Gemini (Gemini Developer API) ---
# Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chemin de la base SQLite
DATABASE_PATH=data/sales.db

# Origines autorisées pour le CORS (frontend Next.js)
# Ajoutez ici l'adresse utilisée pour ouvrir l'interface (ex: 192.168.x.x:3000)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.56.1:3000"]
